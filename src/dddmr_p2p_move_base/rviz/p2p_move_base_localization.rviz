Panels:
  - Class: rviz_common/Displays
    Help Height: 140
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Map1/Topic1
        - /WeightGround1/Topic1
        - /SubMap1/Topic1
        - /mcl_euc_cluster1/Topic1
        - /GlobalPath1
        - /GlobalMarking1/Topic1
        - /ClearingTracing1/Topic1
        - /Path1
        - /perception_local_current_observation1/Topic1
      Splitter Ratio: 0.5823529362678528
    Tree Height: 303
  - Class: rviz_common/Selection
    Name: Selection
  - Class: rviz_common/Tool Properties
    Expanded:
      - /Publish Point1
      - /3D Pose Estimate1
      - /3D Goal Pose1
    Name: Tool Properties
    Splitter Ratio: 0.5886790156364441
  - Class: rviz_common/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
  - Class: rviz_common/Time
    Experimental: false
    Name: Time
    SyncMode: 0
    SyncSource: Map
